# dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# runtime state written by the plugin
.media-senses-cache/
*.tmp
*.partial-*

# large or downloadable binaries
# yt-dlp is fetched locally: see bin/README.md
bin/yt-dlp.exe
bin/yt-dlp
bin/*.exe

# test fixtures are generated by the test scripts themselves
test/fixtures/

# upstream research material pulled for one absorption round (recipe-card
# markdown, style manifests, reference docs). The distilled data lives in
# lib/*.js and the attribution lives in THIRD-PARTY.md, so the raw material is
# not redistributed with the plugin.
test/_research/

# screen tests and analysis artifacts
test/fixtures/artifacts/
demo/output/*/keyframes/
demo/output/*/frames/
demo/output/screen-peek.png
demo/output/*screen-sheet-6-frames*

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.log

# Riemann documentary render scratch (chunks, stills, test renders)
demo/output/riemann/_*
demo/output/riemann/chunks/
demo/output/riemann/clips/*.html
demo/output/riemann/assets/*.wav
# 成片与镜头成品不进仓库（几十 MB），交付时留在本机
demo/output/riemann/*.mp4
demo/output/riemann/clips/
